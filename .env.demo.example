# Deterministic P5 Docker demo. These values are non-secret fixtures and must not be reused for production.
MYSQL_ROOT_PASSWORD=demo-local-password
# Historical migrations explicitly select this canonical schema name.
# Isolation is provided by the dedicated passage-agent-demo-mysql-data volume.
MYSQL_DATABASE=ai_passage_creator
MYSQL_USER=root
REDIS_PASSWORD=
BACKEND_PORT=18123
FRONTEND_PORT=18080
TZ=Asia/Hong_Kong
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC
LITELLM_BASE_URL=http://127.0.0.1:9
LITELLM_API_KEY=demo-not-used
LITELLM_MODEL=demo-fixture-not-called
PEXELS_API_KEY=demo-not-used
PASSAGE_DEMO_ACKNOWLEDGE_NON_PRODUCTION=true
