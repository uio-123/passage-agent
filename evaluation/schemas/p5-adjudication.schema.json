{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://passage-agent.invalid/schemas/p5-adjudication.schema.json",
  "title": "Passage Agent P5 review adjudication",
  "type": "object",
  "required": ["datasetVersion", "datasetSha256", "reviewerIds", "reviewSha256", "adjudicatorId", "adjudicatedAt", "samples"],
  "properties": {
    "datasetVersion": { "const": "p5-v1" },
    "datasetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewerIds": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true },
    "reviewSha256": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true },
    "adjudicatorId": { "type": ["string", "null"] },
    "adjudicatedAt": { "type": ["string", "null"], "format": "date-time" },
    "samples": { "type": "array", "minItems": 30, "maxItems": 30 }
  },
  "additionalProperties": false
}
